# ---------------------------------------------------------------------------
# Model serving
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:1234
DOCKER_API_BASE_URL=http://host.docker.internal:1234
API_KEY=
MODEL_NAME=Qwen/Qwen3.5-4B
ORCHESTRATION_MODEL_NAME=Qwen/Qwen3.5-2B

# ---------------------------------------------------------------------------
# Chat server
# ---------------------------------------------------------------------------
CHAT_SERVER_NAME=0.0.0.0
CHAT_SERVER_PORT=7860
# Required whenever CHAT_SERVER_NAME is not a loopback address.
# Format: user:password (comma-separated for several accounts).
CHAT_AUTH=workshop:change-me
CHAT_ENTRY_AGENT=planner

# ---------------------------------------------------------------------------
# Distributed transport (Lab 6)
# ---------------------------------------------------------------------------
AGENTIC_TRANSPORT=redis_streams
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_PREFIX=agentic
REDIS_STREAM_MAXLEN=100000
EVENT_STORE_PATH=
DISTRIBUTED_REQUIRE_EVENT_STORE=false
DISTRIBUTED_MAX_DELIVERY_ATTEMPTS=3
DISTRIBUTED_RETRY_MIN_IDLE_MS=5000
DISTRIBUTED_CHAT_SOURCE=chat
DISTRIBUTED_CHAT_TIMEOUT_SECONDS=60
AGENT_HEARTBEAT_SECONDS=5
AGENT_LIVENESS_TTL_SECONDS=20

# ---------------------------------------------------------------------------
# Lab 6 web search
# ---------------------------------------------------------------------------
LANGSEARCH_API_KEY=
LANGSEARCH_BASE_URL=https://api.langsearch.com
LANGSEARCH_TIMEOUT=20
LAB6_SEARCH_RESULTS_PER_QUERY=5
LAB6_SUMMARY_MAX_RESULTS=6
LAB6_SUMMARY_SNIPPET_CHARS=600
LAB6_SUMMARY_TOTAL_CHARS=6000

# ---------------------------------------------------------------------------
# MLflow stack (containers/docker-compose.yml) — dev defaults, change for real use
# ---------------------------------------------------------------------------
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow-dev-password
POSTGRES_DB=mlflow

MINIO_ROOT_USER=minio-dev
MINIO_ROOT_PASSWORD=minio-dev-password
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=mlflow

MLFLOW_VERSION=3.15.1
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5001
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow-dev-password@postgres:5432/mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow/
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1
